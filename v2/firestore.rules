rules_version = '2';

// Reglas de seguridad para CompraFácil.
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /restaurantes/{restaurante}/{documento=**} {
      // Solo usuarios con sesión iniciada (los que tú creas en Authentication).
      allow read, write: if request.auth != null;

      // Opción más estricta: solo estos correos. Quita las // de abajo
      // y borra la línea de arriba.
      // allow read, write: if request.auth != null
      //   && request.auth.token.email in ['francisco@correo.com', 'cocina@correo.com'];
    }
  }
}
